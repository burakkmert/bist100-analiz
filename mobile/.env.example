# Supabase (Kişi 2 projeyi açınca doldurur). Boşsa uygulama "demo mod"da açılır.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sunucu adresi: bilgisayarın yerel IP'si (run_ai_dev.sh başlarken ekrana yazar). localhost YAZMAYIN.
EXPO_PUBLIC_API_URL=
# Hisse/fon verileri: Kişi 2'nin sunucusu hazır olana kadar sahte (1)
EXPO_PUBLIC_MOCK=1
# Yapay zekâ: 0 = gerçek sunucu (Gemini), 1 = sahte cevaplar
EXPO_PUBLIC_AI_MOCK=0
