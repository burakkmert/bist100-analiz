{
  "expo": {
    "name": "Fon Takip",
    "slug": "fon-takip",
    "scheme": "fontakip",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fontakip.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.fontakip.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E9EBEF",
          "dark": {
            "backgroundColor": "#0B1A3A"
          }
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
