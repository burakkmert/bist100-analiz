# backend/.env içine eklenecek (Kişi 2'nin .env dosyasına). Anahtar ASLA repoya ve mobil uygulamaya konmaz.
LLM_PROVIDER=fake                 # model hazır olunca: deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_VISION_MODEL=            # grafik okuma için görsel destekli model adı (belgelerden kontrol edin)

# Ücretsiz seçenek 1 — Google Gemini (aistudio.google.com → Get API key)
# LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ücretsiz seçenek 2 — Kendi bilgisayarında Ollama (ollama.com)
# LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5vl:7b
