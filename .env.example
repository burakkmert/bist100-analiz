# Kopyala:  cp .env.example .env   (Windows: copy .env.example .env)
# .env repoya GİRMEZ. Yeni bir ayar eklersen buraya da ekle.

# Veritabanı (docker compose bu kullanıcıyla PostgreSQL 16 açar)
POSTGRES_USER=fon
POSTGRES_PASSWORD=fon
POSTGRES_DB=fontakip
# Bilgisayardan (Docker dışından) bağlanan betikler için — ör. Kişi 1'in --db seçeneği
DATABASE_URL=postgresql+psycopg://fon:fon@localhost:5432/fontakip

# Uygulama (Kişi 2)
APP_ENV=dev
CORS_ORIGINS=*
# Mock mod: 1 ise API sahte veri döner
MOCK=1
# Yalnızca geliştirme: 1 ise token'sız istekler "dev" kullanıcısı sayılır (APP_ENV=dev iken).
# Mobilde Supabase girişi hazır olana kadar uygulamayı denemek için. Sunucuda daima 0.
AUTH_DEV_BYPASS=0

# Supabase Auth (Kişi 2)
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Boşsa SUPABASE_URL + /auth/v1/.well-known/jwks.json kullanılır (asimetrik anahtarlı projeler)
SUPABASE_JWKS_URL=

# LLM (Kişi 3) — sağlayıcı henüz seçilmedi; ayrıntılar backend/app/ai/.env.example
LLM_PROVIDER=fake
LLM_API_KEY=

# Expo Push (Kişi 2)
EXPO_ACCESS_TOKEN=
